# 环境变量配置模板
# 使用方法：复制本文件为 .env 并填入真实值
# 注意：.env 文件应加入 .gitignore，不要提交到仓库

# ============================================
# OpenClaw 配置 (如有)
# ============================================

# OpenClaw Gateway 地址
# OPENCLAW_GATEWAY_URL=http://localhost:3000

# OpenClaw API Key (如有)
# OPENCLAW_API_KEY=your_api_key_here

# ============================================
# GitHub 配置 (如有)
# ============================================

# GitHub Personal Access Token (仅用于需要写权限的操作)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub 用户名
# GITHUB_USERNAME=your_username

# ============================================
# 服务器配置 (如有)
# ============================================

# 服务器 SSH Host
# SSH_HOST=your_server_host

# SSH 用户名
# SSH_USER=your_ssh_user

# SSH 端口 (默认 22)
# SSH_PORT=22

# ============================================
# 自定义配置 (如有)
# ============================================

# 自定义变量示例
# CUSTOM_VAR=value

# ============================================
# 说明
# ============================================
# 1. 复制本文件为 .env
# 2. 填入真实值（不要保留注释中的示例值）
# 3. 确保 .env 在 .gitignore 中
# 4. 切勿将 .env 提交到仓库